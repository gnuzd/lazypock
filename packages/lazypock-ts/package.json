{
	"name": "lazypock",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.global.js",
	"jsdelivr": "./dist/index.global.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"tsup": "^8.4.0",
		"typescript": "^5.9.3"
	}
}