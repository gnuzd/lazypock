{
  "name": "lazypock",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "generate": "node dist/cli.js",
    "smoke": "npm run build && node smoke-test.mjs && tsc --noEmit --strict --target es2020 --module esnext --moduleResolution bundler type-test.ts",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "lazypock-gen": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  }
}
