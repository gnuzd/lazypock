{
	"name": "lazypock-docs",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"sync": "node scripts/sync-sdks.mjs",
		"dev": "node scripts/sync-sdks.mjs && vite dev",
		"build": "node scripts/sync-sdks.mjs && vite build",
		"preview": "vite preview",
		"check": "node scripts/sync-sdks.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"mdsvex": "^0.12.8",
		"svelte": "^5.2.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	},
	"dependencies": {
		"highlight.js": "^11.12.0"
	}
}
