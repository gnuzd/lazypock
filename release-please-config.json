{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "lazypock",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='lazypock'||@.name.value==='lazypock-api'||@.name.value==='lazypock-auth'||@.name.value==='lazypock-core'||@.name.value==='lazypock-db'||@.name.value==='lazypock-files'||@.name.value==='lazypock-hooks'||@.name.value==='lazypock-mail'||@.name.value==='lazypock-realtime'||@.name.value==='lazypock-studio-embed')].version"
        }
      ]
    }
  }
}
