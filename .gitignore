.DS_Store

# Rust build output
/target
**/*.rs.bk

# Local environment / secrets
.env
.env.local
.env.*.local

# Local runtime data (local file storage, outbox spool, ...)
/data
/hooks/*.local.ts

# Studio (SvelteKit) build output
studio/build
studio/.svelte-kit
studio/node_modules
studio/.vite

# Generated Studio bundle embedded into the server binary
crates/studio-embed/dist

# lazypock-ts SDK lives in its own repository (github.com/gnuzd/lazypock-ts).
# This folder is a local convenience checkout, not part of this repo.
lazypock-ts/

# Local tooling config (machine-specific)
.pi/
.pi-subagents/
.repowise
/.claude
/.vscode
.mcp.json
.pi-lens.json
