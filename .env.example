# lazypock configuration.
#
# Copy to `.env` for local development. Real deployments should inject these
# as real environment variables instead of shipping a file.
#
# Only `LAZYPOCK_`-prefixed names are read, and only the ones documented here.
# An unrecognised value is refused at boot rather than silently defaulted, so a
# typo fails loudly instead of running with the wrong setting.
#
# ── what wins: the environment or the database? ───────────────────────────────
#
# Three kinds of setting live in this file, and they behave differently:
#
#   1. Bootstrap settings — the database URL, listen address, pool size, log
#      level and the secrets. There is no other source: these are read from the
#      environment and nowhere else.
#
#   2. Defaults for a setting the database also holds. File storage is the one
#      case today: `LAZYPOCK_FILES_*`, `LAZYPOCK_S3_*` and
#      `LAZYPOCK_IMAGE_SERVICE_*` supply the starting configuration, and a value
#      saved in Studio → Settings → Storage WINS OVER ALL OF THEM. A saved
#      configuration also takes effect without a restart, so these can be left
#      unset entirely and configured once in the UI.
#
#      Set them anyway when a deployment has to be reproducible from its
#      environment alone — otherwise a fresh container comes up with no storage
#      configured until somebody opens the Studio.
#
#   3. Settings with no environment variable at all. CORS origins, the SMTP
#      credentials, cron jobs, API keys, collection rules and image presets live
#      only in the database and are edited in the Studio.
#
# The rule is one direction only: the environment is the default, the database
# is the override. `deploy/compose.example.yml` is a worked deployment that
# shows how they fit together.

# ── core ─────────────────────────────────────────────────────────────────────

# Required. Postgres connection string. Must be a DIRECT connection: a
# transaction-mode pooler (PgBouncer) and the pooled endpoint managed providers
# offer do not work, because realtime needs LISTEN/NOTIFY on the direct endpoint
# and a named prepared statement has to survive a pool checkout. See PLAN.md 18.1.
#
# Only the prefixed name is read. A bare `DATABASE_URL` is set by plenty of other
# tooling in the same environment, and honouring it could quietly connect
# lazypock to somebody else's database.
LAZYPOCK_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lazypock

# development | production | test   (default: development)
# `production` also turns on JSON logs unless LAZYPOCK_LOG_FORMAT says otherwise.
LAZYPOCK_ENV=development

# Address the HTTP server binds to. (default: 0.0.0.0:4000)
LAZYPOCK_LISTEN_ADDR=0.0.0.0:4000

# Directory for local data: local file storage and the outbox spool.
# (default: data)
LAZYPOCK_DATA_DIR=data

# Directory for TypeScript hook files. (default: hooks)
LAZYPOCK_HOOKS_DIR=hooks

# trace | debug | info | warn | error   (default: info)
LAZYPOCK_LOG_LEVEL=info
# text | json   (default: text, or json when LAZYPOCK_ENV=production)
LAZYPOCK_LOG_FORMAT=text

# Postgres pool size per node, 1-64. Keep small: many nodes × pool must fit
# the database's max_connections. One extra connection per node is held for
# LISTEN. (default: 5)
LAZYPOCK_POOL_SIZE=5

# Use Postgres prepared statements (default: true).
# Set to false when something between lazypock and Postgres cannot keep named
# prepared statements alive across checkouts. NOTE: lazypock requires a DIRECT
# database connection regardless — see LAZYPOCK_DATABASE_URL above.
LAZYPOCK_PG_PREPARED_STATEMENTS=true

# Maximum accepted upload size in bytes. (default: 5242880 = 5 MiB)
LAZYPOCK_UPLOAD_MAX_BYTES=5242880

# Public base URL, when it differs from the request host (CDN, custom domain).
# Must start with http:// or https://.
# LAZYPOCK_PUBLIC_URL=https://api.example.com

# ── request handling ─────────────────────────────────────────────────────────

# Comma-separated peers whose X-Forwarded-For/X-Real-IP headers are believed, as
# exact addresses or CIDR ranges. Empty (the default) means no forwarding header
# is ever read, because a header the client set is the client naming itself.
# Set this to your reverse proxy, or rate limits and request logs key on the
# proxy's address.
# LAZYPOCK_TRUSTED_PROXIES=10.0.0.1,10.0.0.0/8

# Per-node, in-memory fixed-window limits, per client address. Two nodes behind a
# load balancer allow twice the limit; that is the documented trade rather than
# an oversight (PLAN.md 8.4). 0 disables the limiter.
# LAZYPOCK_RATE_LIMIT_AUTH=20    # requests/min that spend credentials (default 20)
# LAZYPOCK_RATE_LIMIT_API=600    # requests/min for everything else (default 600)

# Failed sign-ins per account before that account is locked out for 15 minutes.
# Only failures count, so a legitimate sign-in never spends the budget, and an
# attacker who knows an address cannot lock its owner out of it. 0 disables it.
# LAZYPOCK_RATE_LIMIT_ACCOUNT=10

# ── secrets ──────────────────────────────────────────────────────────────────

# Encrypts credentials stored in `_settings` with AES-256-GCM. 32 bytes as hex:
#   openssl rand -hex 32
# Optional — but required (and refused if malformed) before a deployment can save
# a secret such as an S3 storage key from the Studio. It also encrypts the
# access-token signing key below when that is kept in the database. Losing it
# means those values can no longer be decrypted.
# LAZYPOCK_SECRET_KEY=change-me

# Optional. Keeps the access-token signing key out of the database, and therefore
# out of every dump and replica. Give it base64 of 32 random bytes:
#   openssl rand -base64 32
# (Base64 of the PKCS#8 key — the `der` value — from an installation's
# `auth.signing_key` setting is accepted too.) Left unset, a key is generated on first run and kept in
# `_settings`, encrypted with LAZYPOCK_SECRET_KEY when that is set.
# LAZYPOCK_SIGNING_KEY=

# The first superuser, for a deployment with no browser and no shell to run
# `lazypock superuser create` in. Created at boot **only while no superuser
# exists**, so it never resets a password on a redeploy. Both or neither: half of
# the pair is a boot error. There is no default account and no default password.
# LAZYPOCK_SUPERUSER_EMAIL=you@example.com
# LAZYPOCK_SUPERUSER_PASSWORD=change-me

# ── file storage ─────────────────────────────────────────────────────────────

# local | s3   (default: local)
# A `storage` setting saved in the Studio overrides the environment.
# LAZYPOCK_FILES_ADAPTER=local

# Root directory for the local adapter. (default: data/files)
# LAZYPOCK_FILES_DIR=data/files

# Public base URL for served objects, when they go through a CDN.
# Must start with http:// or https://.
# LAZYPOCK_FILES_PUBLIC_URL=https://cdn.example.com

# S3/R2 backend. All four of endpoint, bucket, access key and secret are required
# when LAZYPOCK_FILES_ADAPTER=s3. `auto` is the region Cloudflare R2 expects.
# LAZYPOCK_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# LAZYPOCK_S3_BUCKET=lazypock
# LAZYPOCK_S3_REGION=auto
# LAZYPOCK_S3_ACCESS_KEY=change-me
# LAZYPOCK_S3_SECRET_KEY=change-me

# Namespace every object key under this prefix. Set it when several deployments
# share one bucket: the orphan sweeper lists only this prefix, so it cannot see
# (or delete) another deployment's objects.
# LAZYPOCK_FILES_PREFIX=tenants/abc

# Refuse the local adapter outright, including a `local` storage setting saved in
# the Studio (a saved setting overrides the environment). Use it when uploads must
# live in object storage.
# LAZYPOCK_FILES_FORCE_REMOTE=off

# Lifetime of a presigned upload URL, in seconds, 1 second to 7 days.
# (default: 900 = 15 minutes)
# LAZYPOCK_PRESIGN_TTL=900

# ── images ───────────────────────────────────────────────────────────────────

# Resizing runs in-process by default, using the codecs compiled in behind the
# `local-image-codecs` feature. Setting a service URL moves that work (and its
# peak memory) out of the API process; the service contract is documented in
# crates/files/src/image_service.rs. A failure is never silently fallen back to
# the local codecs.
# LAZYPOCK_IMAGE_SERVICE_URL=https://images.example.com/resize
# Bearer token sent to the service. Setting it without a URL is an error.
# LAZYPOCK_IMAGE_SERVICE_TOKEN=change-me

# ── mail ─────────────────────────────────────────────────────────────────────

# SMTP is configured by the `mail` setting (Studio → Settings → Mail), read at
# send time so a change applies to the next email without a restart. These are
# the parts that are not:
#
# Directory of template overrides. `otp`, `verification`, `password_reset` and
# `email_change` each have a built-in `.subject`/`.html`/`.text`; a file with the
# same name here replaces that part, so an email is changed without a rebuild.
# Unset means the built-ins only.
# LAZYPOCK_MAIL_TEMPLATES_DIR=data/mail

# ── background workers ───────────────────────────────────────────────────────

# Adopt tables lazypock did not create as superuser-only collections, so pointing
# lazypock at an existing database is not an empty installation. On/off
# (default: on). Nothing in an adopted table is altered.
# LAZYPOCK_REFLECT_EXISTING=on

# The cron scheduler: how often it looks for jobs whose next_run_at has arrived,
# in seconds. 0 disables it, loudly. (default: 30)
# LAZYPOCK_CRON_INTERVAL=30

# The job-queue worker: how often it looks for queued work, in seconds.
# 0 disables it, loudly. (default: 5)
# LAZYPOCK_JOB_INTERVAL=5

# How long a claim on a job is trusted before the job is handed back, in seconds.
# Covers a worker that dies mid-job. Must be greater than zero. (default: 300)
# LAZYPOCK_JOB_LEASE=300

# The file reaper: how often it removes objects whose rows were deleted and
# uploads nobody attached, in seconds. 0 disables it, loudly — deleted objects
# would stay in storage forever. (default: 3600)
# LAZYPOCK_FILE_REAPER_INTERVAL=3600

# ── backup / import ──────────────────────────────────────────────────────────

# Records above which an archive import must be confirmed. (default: 10000)
# LAZYPOCK_IMPORT_CONFIRM_RECORDS=10000

# ── CLI only ─────────────────────────────────────────────────────────────────

# Password for `lazypock superuser create --email <email>` when the flag is
# omitted. Not read by the server.
# LAZYPOCK_SUPERUSER_PASSWORD=change-me

# ── build-time and tests (not read by the running server) ────────────────────

# Directory holding a prebuilt Studio bundle to embed into the binary. Used by
# the Dockerfile and CI; a plain `cargo build` without it embeds no Studio.
# LAZYPOCK_STUDIO_DIR=studio/build/studio

# Integration tests log "Postgres unreachable" and pass when no database is
# reachable. Set this to make that case a failure instead.
# LAZYPOCK_REQUIRE_DB_TESTS=1
# LAZYPOCK_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lazypock_dev
